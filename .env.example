# ==========================================
# Garmin AI Coach - Environment Variables
# ==========================================

# AI Provider: "gemini" (default, free & recommended) or "openai" (OpenAI, Groq, OpenRouter, Ollama)
AI_PROVIDER=gemini

# Option 1: Google Gemini (Free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Option 2: OpenAI / Groq / OpenRouter / Ollama (OpenAI-compatible)
# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# For Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1 and OPENAI_MODEL=llama-3.3-70b-versatile
# For Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 and OPENAI_MODEL=llama3.1
# For OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 and OPENAI_MODEL=anthropic/claude-3.5-sonnet

# Telegram Bot Token (Optional if using only Web UI)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# If your bot token is shared with another service, leave polling false to avoid 409 conflict errors (push messages still work)
ENABLE_TELEGRAM_POLLING=false


# Sync Settings
SYNC_INTERVAL_MINUTES=30
TIMEZONE=America/Sao_Paulo

# Web UI Settings
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_ADDRESS=0.0.0.0
